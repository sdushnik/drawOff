{
  "name": "drawoff",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/contracts",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:orchestration && npm run test --workspaces --if-present",
    "test:orchestration": "node --test scripts/ci-workflow.test.mjs scripts/e2e-compose.test.mjs scripts/render-blueprint.test.mjs scripts/render-deploy.test.mjs",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "test:e2e:compose": "node scripts/e2e-compose.mjs",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @drawoff/backend",
    "smoke:container": "node scripts/container-smoke.mjs",
    "smoke:observability": "node scripts/observability-smoke.mjs",
    "oncall": "node on-call-engineer/index.mjs",
    "oncall:demo-server": "node on-call-engineer/demo-alert-server.mjs",
    "test:oncall": "node --test on-call-engineer/*.test.mjs",
    "test:observability": "node --test scripts/observability.test.mjs scripts/observability-alerts.test.mjs",
    "test:observability:alerts": "node --test scripts/observability-alerts.test.mjs",
    "verify:compose:websocket": "node scripts/container-smoke.mjs --websocket-only",
    "verify:compose:persistence": "node scripts/compose-persistence.mjs"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.166.0"
  }
}
